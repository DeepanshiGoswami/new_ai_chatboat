# Groq API Configuration
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings & Vector Storage
SENTENCE_TRANSFORMER=all-MiniLM-L6-v2
FAISS_STORAGE_PATH=backend/storage/faiss.index
METADATA_PATH=backend/storage/metadata.json

# Database Configuration
DATABASE_URL=sqlite:///backend/storage/chat.db
DB_PATH=chatbot.db

# Optional: Enable heavy image model (disabled by default for cloud)
ENABLE_IMAGE_MODEL=false
